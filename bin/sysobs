#!/usr/bin/env python3
"""sysobs — a normalized, referentially-intact log of what this machine is doing.

Substrate (derived, never hand-written): ps, lsof, netstat, nettop, top, df,
iostat, vm_stat, sysctl, and libproc via ctypes. Every snapshot is written as a
STAR SCHEMA spread over one CSV per table under $SYSOBS_HOME/tables, so nothing
is stored twice: a file path, an IP address, a port, a volume, an executable
and an interface each live exactly once in a dimension table and are referenced
by id from the per-snapshot fact rows.

    sysobs snapshot [--files none|own|all] [--rdns] [--geo online] [--json]
    sysobs watch --interval 60 [--count N]      repeated snapshots
    sysobs list [--json]                        snapshots on record
    sysobs show <snapshot|latest> [--json]      one snapshot, resolved
    sysobs top <snapshot|latest> [--by cpu|rss|net|files|sockets]
    sysobs verify [--json]                      referential integrity report
    sysobs db [--rebuild] [--json]              build SQLite mirror with real FKs
    sysobs query <sql> [--json]                 run SQL against the mirror
    sysobs schema [--ddl|--json]                the schema, keys and references
    sysobs prune --days N [--go]                drop old snapshots, keep refs intact
    sysobs selftest                             behaviour fixtures

Uniform interface: --json on every reading command; exit 0 ok, 1 finding/failure,
2 usage. Values carry a `source` so a degraded collector is visible, not silent.
"""
from __future__ import annotations

import argparse
import csv
import ctypes
import hashlib
import ipaddress
import json
import os
import platform
import re
import socket as pysocket
import sqlite3
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

VERSION = "0.1.0"
SCHEMA_VERSION = 1

HOME = Path.home()
ROOT = Path(os.environ.get(
    "SYSOBS_HOME",
    Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state")) / "sysobs",
))
TABLES = ROOT / "tables"
DB_PATH = ROOT / "sysobs.sqlite"

csv.field_size_limit(16 * 1024 * 1024)


# ============================================================ schema
# Each table: kind ("dim" = deduped across all time, "fact" = per snapshot),
# columns, primary key, and foreign keys {column: (table, column)}.
# The schema is the single source of truth: the CSV headers, the SQLite DDL and
# the integrity checker are all generated from it, so they cannot drift apart.

class Table:
    def __init__(self, name, kind, columns, pk, fks=None, doc=""):
        self.name, self.kind, self.columns = name, kind, columns
        self.pk = pk
        self.fks = fks or {}
        self.doc = doc

    @property
    def path(self) -> Path:
        return TABLES / f"{self.name}.csv"


SCHEMA: dict[str, Table] = {}


def _t(name, kind, columns, pk, fks=None, doc=""):
    SCHEMA[name] = Table(name, kind, columns, pk, fks, doc)


# ---- dimensions (stable identity, deduped, first_seen/last_seen maintained)
_t("host", "dim",
   ["host_id", "hostname", "hw_uuid", "model", "cpu_brand", "ncpu", "mem_bytes",
    "os_name", "os_version", "kernel", "arch", "first_seen", "last_seen"],
   ["host_id"], {}, "the machine itself")

_t("volume", "dim",
   ["volume_id", "device", "mount_point", "fs_type", "first_seen", "last_seen"],
   ["volume_id"], {}, "a mounted filesystem; the location a file path lands on")

_t("disk_device", "dim",
   ["device_id", "device_name", "first_seen", "last_seen"],
   ["device_id"], {}, "a block device as iostat names it")

_t("interface", "dim",
   ["interface_id", "name", "mtu", "mac", "first_seen", "last_seen"],
   ["interface_id"], {}, "a network interface")

_t("file", "dim",
   ["file_id", "path", "directory", "basename", "extension", "volume_id",
    "first_seen", "last_seen"],
   ["file_id"], {"volume_id": ("volume", "volume_id")},
   "THE normalized file location: every path in the log points here, once")

_t("command", "dim",
   ["command_id", "exe_path", "basename", "file_id", "first_seen", "last_seen"],
   ["command_id"], {"file_id": ("file", "file_id")},
   "an executable image, normalized onto its file location")

_t("ip_address", "dim",
   ["address_id", "address", "family", "scope", "is_local", "rdns",
    "geo_source", "geo_country", "geo_region", "geo_city", "geo_org",
    "first_seen", "last_seen"],
   ["address_id"], {}, "an IP address seen at either end of a socket")

_t("port", "dim",
   ["port_id", "protocol", "port", "service_name", "first_seen", "last_seen"],
   ["port_id"], {}, "a protocol/port pair, named from /etc/services when known")

# ---- facts (one set per snapshot)
_t("snapshot", "fact",
   ["snapshot_id", "host_id", "started_at", "finished_at", "duration_ms",
    "tool_version", "schema_version", "euid", "privileged", "files_mode",
    "note"],
   ["snapshot_id"], {"host_id": ("host", "host_id")}, "one capture run")

_t("collector_run", "fact",
   ["snapshot_id", "collector", "status", "degraded", "duration_ms", "rows",
    "message"],
   ["snapshot_id", "collector"], {"snapshot_id": ("snapshot", "snapshot_id")},
   "what each collector managed to see, so a gap is recorded not implied")

_t("host_sample", "fact",
   ["snapshot_id", "uptime_s", "load1", "load5", "load15",
    "cpu_user_pct", "cpu_sys_pct", "cpu_idle_pct",
    "procs_total", "procs_running", "procs_sleeping", "threads_total",
    "mem_total_bytes", "mem_used_bytes", "mem_unused_bytes", "mem_wired_bytes",
    "mem_compressed_bytes", "mem_active_bytes", "mem_inactive_bytes",
    "mem_free_bytes", "mem_speculative_bytes", "mem_purgeable_bytes",
    "page_size", "pageins", "pageouts", "swapins", "swapouts",
    "swap_total_bytes", "swap_used_bytes", "swap_free_bytes",
    "net_pkts_in", "net_pkts_out", "net_bytes_in", "net_bytes_out",
    "disk_reads", "disk_writes", "disk_bytes_read", "disk_bytes_written"],
   ["snapshot_id"], {"snapshot_id": ("snapshot", "snapshot_id")},
   "the machine-wide reading at snapshot time")

_t("process", "fact",
   ["snapshot_id", "pid", "ppid", "pgid", "uid", "username", "command_id",
    "argv", "started_at", "elapsed_s", "tty"],
   ["snapshot_id", "pid"],
   {"snapshot_id": ("snapshot", "snapshot_id"), "command_id": ("command", "command_id")},
   "process identity within a snapshot")

_t("process_sample", "fact",
   ["snapshot_id", "pid", "state", "priority", "nice", "cpu_pct", "mem_pct",
    "rss_bytes", "vsz_bytes", "cpu_time_s", "user_time_s", "system_time_s",
    "threads", "faults", "pageins", "cow_faults", "csw", "syscalls_mach",
