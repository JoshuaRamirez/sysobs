<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>local.sysobs-prune</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Developer/sysobs/bin/sysobs</string>
    <string>prune</string>
    <string>--days</string><string>14</string>
    <string>--go</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key> <integer>0</integer>
    <key>Hour</key>    <integer>4</integer>
    <key>Minute</key>  <integer>15</integer>
  </dict>
  <key>RunAtLoad</key>          <false/>
  <key>ProcessType</key>        <string>Background</string>
  <key>LowPriorityIO</key>      <true/>
  <key>Nice</key>               <integer>10</integer>
  <key>StandardOutPath</key>    <string>__HOME__/Library/Logs/sysobs-prune.log</string>
  <key>StandardErrorPath</key>  <string>__HOME__/Library/Logs/sysobs-prune.log</string>
</dict>
</plist>
