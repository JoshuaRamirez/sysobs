<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>local.sysobs</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Developer/sysobs/bin/sysobs</string>
    <string>snapshot</string>
    <string>--files</string><string>none</string>
    <string>--note</string><string>launchd</string>
  </array>
  <key>StartInterval</key>      <integer>300</integer>
  <key>RunAtLoad</key>          <true/>
  <key>ProcessType</key>        <string>Background</string>
  <key>LowPriorityIO</key>      <true/>
  <key>Nice</key>               <integer>10</integer>
  <key>StandardOutPath</key>    <string>__HOME__/Library/Logs/sysobs.log</string>
  <key>StandardErrorPath</key>  <string>__HOME__/Library/Logs/sysobs.log</string>
</dict>
</plist>
